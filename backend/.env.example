# Copie para backend/.env e preencha.

# Chave da API do Gemini (necessária para responder perguntas)
GOOGLE_API_KEY=

# Modelo do Gemini. O padrão do código (gemini-2.5-flash) não está disponível para contas novas
LLM_MODEL=gemini-3.5-flash-lite

# ID da pasta do Google Drive com os PDFs, fica na URL da pasta (necessário só para sincronizar)
GOOGLE_DRIVE_FOLDER_ID=

# Caminho do JSON da Service Account (padrão: credentials/service_account.json)
# GOOGLE_CREDENTIALS_PATH=credentials/service_account.json

# Índice usado pelo chat (padrão: faiss_index, criado pela sincronização com o Drive).
# Sem Service Account, dá para usar o índice da avaliação: faiss_index_eval
# FAISS_INDEX_PATH=faiss_index_eval

# Aceita o botão "Skip Login (Dev)" do frontend. Só para desenvolvimento local, nunca em produção
AUTH_DEV_MODE=true
