# Copie para backend/.env e preencha.

# Chave da API do Gemini (necessária para responder perguntas)
GOOGLE_API_KEY=

# ID da pasta do Google Drive com os PDFs, fica na URL da pasta (necessário só para sincronizar)
GOOGLE_DRIVE_FOLDER_ID=

# Caminho do JSON da Service Account (padrão: credentials/service_account.json)
# GOOGLE_CREDENTIALS_PATH=credentials/service_account.json
